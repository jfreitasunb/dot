/* Generated from wallpaper: tuxanaut.png */

* {
    bg:          #0f151f;
    fg:          #d2ccbc;
    accent:      #1359d3;
    accent-2:    #eed086;
    border:      #1359d3;
    urgent:      #cb8a86;
    selected-fg: #d2ccbc;
    entry-fg:    #eed086;
    prompt-fg:   #1359d3;
    header:      #eed086;

    background-color: @bg;
}
